{
  "name": "@rgywd/dsh-novel-studio",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "A local, version-safe Writer and Director workbench for DSH",
  "main": "./dist/plugin.js",
  "exports": {
    ".": "./dist/plugin.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/server.js",
    "dev": "npm run build && npm start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:unit": "node --import tsx --test test/context.test.ts test/review.test.ts test/compiler-unit.test.ts",
    "test:integration": "node --import tsx --test test/domain.test.ts test/runtime.test.ts test/guards.test.ts test/workbench.test.ts test/plugin.test.ts test/configuration.test.ts test/memory.test.ts",
    "test:e2e": "node --import tsx --test test/http.test.ts test/upgrade-http.test.ts",
    "smoke:real": "node scripts/real-smoke.mjs",
    "start:dsh": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/serve.ps1 -Dsh",
    "start:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/serve.ps1",
    "smoke:upgrade": "node scripts/upgrade-smoke.mjs",
    "test:old-projects": "node scripts/upgrade-regression.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "codemirror": "6.0.1",
    "diff": "8.0.2",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.24.2",
    "zod-to-json-schema": "3.24.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent-default-model": "0.1.5-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent-default-model": "0.1.5-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.1",
    "@deepseek-ai/dsh-scope": "0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.1",
    "@types/node": "24.3.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "esbuild": "0.25.9",
    "tsx": "4.20.5",
    "typescript": "5.7.3"
  }
}
